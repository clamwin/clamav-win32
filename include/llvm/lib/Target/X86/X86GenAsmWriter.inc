/// printInstruction - This method is automatically generated by tablegen
/// from the instruction set description.
void X86ATTInstPrinter::printInstruction(const MCInst *MI, uint64_t Address, raw_ostream &O) {
  O << "\t";

  auto MnemonicInfo = getMnemonic(MI);

  O << MnemonicInfo.first;

  uint64_t Bits = MnemonicInfo.second;
  assert(Bits != 0 && "Cannot print this instruction.");

  // Fragment 0 encoded into 7 bits for 81 unique commands.
  switch ((Bits >> 15) & 127) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // DBG_VALUE, DBG_VALUE_LIST, DBG_INSTR_REF, DBG_PHI, DBG_LABEL, BUNDLE, ...
    return;
    break;
  case 1:
    // SEH_PushFrame, SEH_PushReg, SEH_SaveReg, SEH_SaveXMM, SEH_SetFrame, SE...
    printOperand(MI, 0, O);
    break;
  case 2:
    // XOR32_FP, XOR64_FP, AESIMCrr, ARPL16rr, BLCFILL32rr, BLCFILL64rr, BLCI...
    printOperand(MI, 1, O);
    break;
  case 3:
    // ADC16mi, ADC16mi8, ADC16mr, ADC32mi, ADC32mi8, ADC32mr, ADC64mi32, ADC...
    printOperand(MI, 5, O);
    O << ", ";
    break;
  case 4:
    // ADC16ri, ADC16ri8, ADC16rr, ADC16rr_REV, ADC32ri, ADC32ri8, ADC32rr, A...
    printOperand(MI, 2, O);
    O << ", ";
    break;
  case 5:
    // ADC16rm, ADD16rm, AND16rm, CRC32r32m16, IMUL16rm, OR16rm, SBB16rm, SUB...
    printwordmem(MI, 2, O);
    O << ", ";
    break;
  case 6:
    // ADC32rm, ADCX32rm, ADD32rm, ADDSSrm, ADDSSrm_Int, ADOX32rm, AND32rm, A...
    printdwordmem(MI, 2, O);
    break;
  case 7:
    // ADC64rm, ADCX64rm, ADD64rm, ADDSDrm, ADDSDrm_Int, ADOX64rm, AND64rm, A...
    printqwordmem(MI, 2, O);
    break;
  case 8:
    // ADC8rm, ADD8rm, AND8rm, CRC32r32m8, CRC32r64m8, OR8rm, SBB8rm, SUB8rm,...
    printbytemem(MI, 2, O);
    O << ", ";
    break;
  case 9:
    // ADDPDrm, ADDPSrm, ADDSUBPDrm, ADDSUBPSrm, AESDECLASTrm, AESDECrm, AESE...
    printxmmwordmem(MI, 2, O);
    O << ", ";
    break;
  case 10:
    // ADD_F32m, ADD_FI32m, CALL32m, CALL32m_NT, CLRSSBSY, DEC32m, DIV32m, DI...
    printdwordmem(MI, 0, O);
    return;
    break;
  case 11:
    // ADD_F64m, CALL64m, CALL64m_NT, CMPXCHG8B, DEC64m, DIV64m, DIVR_F64m, D...
    printqwordmem(MI, 0, O);
    return;
    break;
  case 12:
    // ADD_FI16m, CALL16m, CALL16m_NT, DEC16m, DIV16m, DIVR_FI16m, DIV_FI16m,...
    printwordmem(MI, 0, O);
    return;
    break;
  case 13:
    // ADD_FPrST0, ADD_FST0r, ADD_FrST0, CMOVBE_F, CMOVB_F, CMOVE_F, CMOVNBE_...
    printSTiRegOperand(MI, 0, O);
    break;
  case 14:
    // AESDEC128KL, AESDEC256KL, AESENC128KL, AESENC256KL
    printMemReference(MI, 2, O);
    O << ", ";
    printOperand(MI, 1, O);
    return;
    break;
  case 15:
    // AESDECWIDE128KL, AESDECWIDE256KL, AESENCWIDE128KL, AESENCWIDE256KL, FA...
    printMemReference(MI, 0, O);
    return;
    break;
  case 16:
    // AESIMCrm, BNDMOV64rm, CVTDQ2PSrm, CVTPD2DQrm, CVTPD2PSrm, CVTPS2DQrm, ...
    printxmmwordmem(MI, 1, O);
    O << ", ";
    printOperand(MI, 0, O);
    return;
    break;
  case 17:
    // AESKEYGENASSIST128rm, EXTRACTPSmr, MMX_PSHUFWmi, PCMPESTRIrm, PCMPESTR...
    printU8Imm(MI, 6, O);
    O << ", ";
    break;
  case 18:
    // AESKEYGENASSIST128rr, BTC16ri8, BTC32ri8, BTC64ri8, BTR16ri8, BTR32ri8...
    printU8Imm(MI, 2, O);
    break;
  case 19:
    // BEXTR32rm, BEXTR64rm, BEXTRI32mi, BEXTRI64mi, BZHI32rm, BZHI64rm, IMUL...
    printOperand(MI, 6, O);
    O << ", ";
    break;
  case 20:
    // BLCFILL32rm, BLCI32rm, BLCIC32rm, BLCMSK32rm, BLCS32rm, BLSFILL32rm, B...
    printdwordmem(MI, 1, O);
    break;
  case 21:
